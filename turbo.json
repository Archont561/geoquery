{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "biome.json",
    "tsconfig.base.json",
    "pixi.toml",
    "pixi.lock",
    "Cargo.toml",
    "Cargo.lock",
    "deny.toml"
  ],
  "globalEnv": ["GEOQUERY_VERSION"],
  // Strict environment mode passes a task only the variables named here, in `globalEnv`, or
  // in turbo's built-in OS list. Pixi's activation is what points cargo at the restored
  // sandbox: `CARGO_HOME` holds the vendored source replacement and `CARGO_TARGET_*_LINKER`
  // names the conda linker. Stripped, every cargo command in the fan-out — fmt, clippy, deny,
  // nextest, llvm-cov — falls back to `~/.cargo`, finds no vendored crates, and reaches for
  // crates.io, so an offline `pixi run gates` fails at dependency resolution before it runs a
  // single check. Passthrough rather than `globalEnv` because the path is a property of the
  // machine and not an input: the Rust and Python nodes are `cache: false` regardless, and
  // hashing it would only stop a sandbox and CI from ever sharing a cache entry.
  //
  // `CC`/`CC_x86_64_unknown_linux_gnu`/`AR_x86_64_unknown_linux_gnu` need the same treatment
  // and for the same reason: `CARGO_TARGET_*_LINKER` only tells rustc which binary links the
  // final artifact, but `cc`-rs (used by `aws-lc-sys` and friends to compile their vendored C
  // sources) picks its compiler from these separately, with a bare `cc` fallback when they're
  // unset. Without passthrough, turbo strips them before the `test`/`cov` tasks ever invoke
  // `cargo`, so `cc`-rs silently falls back to the host's own `/usr/bin/cc` while the linker
  // stays pinned to pixi's conda cross toolchain — on a host whose system libc is newer than
  // pixi's locked `sysroot_linux-64`, that mismatch produces linker errors like
  // `undefined symbol: __isoc23_sscanf` (glibc >=2.38's versioned symbols vs. the older
  // sysroot the linker targets) that never reproduce when cargo is run directly (bypassing
  // turbo) with the exact same pixi.toml.
  "globalPassThroughEnv": [
    "CARGO_*",
    "CC",
    "CC_x86_64_unknown_linux_gnu",
    "AR_x86_64_unknown_linux_gnu"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    // `coverage/**` alongside `coverage.xml`: pytest-cov writes the second, bun writes an
    // lcov report into the first, and cargo-llvm-cov writes outside the package entirely
    // (`target/lcov.info`), which is why the Rust node declares no output at all.
    "cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage.xml", "coverage/**"]
    },
    "fmt": {
      "cache": false
    },
    "advisories": {
      "cache": false
    },
    "//#lint": {
      "inputs": ["**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc}", "biome.json"]
    },
    "//#fmt": {
      "cache": false
    }
  }
}
