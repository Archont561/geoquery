{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "biome.json",
    "tsconfig.base.json",
    "pixi.toml",
    "pixi.lock",
    "Cargo.toml",
    "Cargo.lock",
    "deny.toml"
  ],
  "globalEnv": ["GEOQUERY_VERSION"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage.xml"]
    },
    "fmt": {
      "cache": false
    },
    "advisories": {
      "cache": false
    },
    "//#lint": {
      "inputs": ["**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc}", "biome.json"]
    },
    "//#fmt": {
      "cache": false
    }
  }
}
