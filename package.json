{
  "name": "geoquery",
  "private": true,
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "description": "One protocol-independent query language and execution engine for federating geospatial resources and services",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "apps/*",
    "crates",
    "python/geoquery"
  ],
  "scripts": {
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "all:build": "turbo run build",
    "all:test": "turbo run test",
    "all:typecheck": "turbo run typecheck",
    "all:lint": "turbo run lint",
    "all:cov": "turbo run cov",
    "all:fmt": "turbo run fmt",
    "all:advisories": "turbo run advisories"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.3.11",
    "backlog.md": "^1.53.0",
    "skills": "^1.7.0",
    "turbo": "^2.11.5",
    "typescript": "^5.9.0"
  }
}
